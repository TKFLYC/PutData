# =============================================================================
# 賣貨便 (7-ELEVEN MyShip) 環境設定範本 — 複製成 ../MyShip/myship.conf 後填實際值
#   cp config/myship.conf.example MyShip/myship.conf
# 注意: 真實 .conf 已被 .gitignore 排除，不會進版控。
# 部署後請確認:
#   1. LOG_FILE          = NimoShake 這台主機實際的 log 路徑
#   2. SENDGRID_API_KEY  = 填入實際金鑰
#   3. HOST_ROLE         = 測試機 / 正式機
# =============================================================================
ENV_NAME="MyShip"            # 環境代號，顯示在信件主旨與記錄 (賣貨便)
HOST_ROLE="測試機"           # 顯示在信件主旨: 【StarCo MyShip·測試機】；正式環境改 "正式機"

# NimoShake log 路徑 (請改成主機實際位置)
LOG_FILE="/var/log/nimoshake/myship/nimo-shake.log"

# ---- SendGrid 連線參數 ----
SENDGRID_API_KEY="SG.xxxxxxxx"             # << 換新金鑰改這行即可
# SENDGRID_API_KEY_FILE="/path/to/key.txt"  # 或改用外部金鑰檔 (與上行擇一)
SENDGRID_API_HOST="api.sendgrid.com"       # API 模式 (程式使用，走 443)
SENDGRID_API_PORT="443"
SENDGRID_SMTP_SERVER="smtp.sendgrid.net"   # SMTP 資訊僅作紀錄備查 (587 TLS / 465 SSL)
SENDGRID_SMTP_PORT="587"                   # 目前程式僅走 API，未實作 SMTP 切換
SENDGRID_SMTP_USERNAME="apikey"            # SMTP 帳號固定為 apikey，密碼即上方 API Key

# ---- 發信人 / 收件人 ----
MAIL_FROM="c2cteam@pic.net.tw"             # 賣貨便發信信箱
MAIL_FROM_NAME="StarCo Monitor (MyShip)"
MAIL_TO="tony.zhang@stockfeel.com.tw"      # 可多個收件人，逗號分隔，例: "a@x.com,b@y.com"

# ---- 告警行為 ----
DRY_RUN=1                 # << 安全預設: 1=只寫 log 不寄信。觀察無誤後才改 0 才會真的寄
ALERT_MIN_SEVERITY=medium # 低於此嚴重度只記錄不寄信 (high>medium>low>info)
                          # 注意: low 級 (慢寫入/慢讀取) 在預設 medium 下不寄信，要收改 low
REALERT_INTERVAL=21600    # 未解除問題每 6 小時提醒一次 (秒；0=不重複提醒)
GLOBAL_COOLDOWN=60        # 任兩封信最小間隔 (秒)
MAX_MAILS_PER_RUN=10      # 單次執行寄信上限
NOTIFY_RESOLVED=1         # 問題恢復時寄「已解除」通知 (0=不寄)

# ---- 監控門檻 ----
EXPECT_RUNNING=0          # 1=程序必須常駐，找不到就告警；0=自動判斷 (只在全量未完成即中止時告警)
STALL_SECONDS=300         # log 停滯幾秒視為異常 (程序不在時)
HANG_SECONDS=60           # 程序在但 log 停寫幾秒視為疑似假死
SLOW_WRITE_MS=200         # 慢寫入門檻 (毫秒，目標 MongoDB)
SLOW_SCAN_MS=500          # 慢讀取門檻 (毫秒，來源 DynamoDB)
SCAN_TAIL_LINES=2000      # 效能取樣行數 (log 尾端)
PROC_PATTERN="(^|/)nimo-shake(\.(linux|darwin))?( |$)"  # pgrep -f 用的錨定 regex；相容 nimo-shake.linux 檔名，避免誤中 log 路徑/監控腳本自身

# ---- 全量進度基準 (選填) ----
# 設定各 table 來源總筆數後，報表 [3] 會顯示 進度% 與 預計剩餘時間。
# 基準值可由「上次完成的全量 log」一鍵產生:  bash nimoshake-monitor.sh --totals /path/to/舊全量log
# TABLE_TOTALS="Orders:5200000,Users:130000"
# (v4.3) 沒設 TABLE_TOTALS 時，全量進行中會自動向 NimoShake 內建 API (localhost:9341/progress) 取
#        各 table 來源筆數當基準 (DynamoDB ItemCount 概估)，不用手動填也有進度%；有設的 table 以這裡為準。
# ---- NimoShake 內建監控 API 端口 (選填；與 nimo-shake.conf 的 full_sync.http_port / incr_sync.http_port 一致) ----
# HTTP_FULL_PORT=9341       # 全量進度 API (/progress)，[3] 進度% 自動基準的來源
# HTTP_INCR_PORT=9340       # 增量統計 API (/metric)，[2] CDC 讀取/寫入累計的來源
# ---- CDC (增量) 專版統計行字樣 (選填) ----
# 專版 nimo-shake-starco 增量階段每 5 秒寫一行累計統計:
#   [2026/09/07 19:53:59 UTC] [INFO] [stage=incr, get=21, write_success=21, tps=0, ckpt_times=21]
# 監控會取最新一行的 get(讀取)/write_success(寫入)/tps/ckpt_times 與取樣區間增量顯示在 [2]。
# 注意實際字樣是 stage=incr (等號)；grep 時請用 grep "stage=incr"。字樣改版時在此修改。
# INCR_TAG="stage=incr"

# ---- FullCheck 結束通知 (選填) ----
# 設定後，nimo-full-check 全量複核跑完 (輸出資料夾出現 run-manifest.json)
# 1 分鐘內自動寄結果信: outcome (PASS/PASS_WITH_EXCEPTIONS/FAIL)、各 table
# 統計 (checked/passed/failed/exceptions)、耗時。fullcheck 照原本指令跑即可。
# 失敗也會通知: 程序消失卻沒有新結果檔 (OOM/kill/斷線) → 🔴 異常結束告警。
# 填 nimo-full-check.linux 的「執行目錄」(輸出資料夾 -d 通常在其下一層)，
# 可逗號分隔多個。首次啟用只建基準，不會補寄歷史結果；同一次結果只通知一次。
# FULLCHECK_DIR="/home/ForTest_NimoShakeStarCoVersion/nimo-shake-starco-1.0.14-sc.20260818"
# FULLCHECK_PROC_PATTERN="(^|/)nimo-full-check(\.(linux|darwin))?( |$)"  # 程序比對 regex，執行檔改名才需調整
# --- 原生版環境專用: 機器上的 fullcheck 是原生 git 版時才設 ---
# 原生版不寫 run-manifest.json，判別改用「程序結束 + 讀輸出資料夾 diff 檔」。
# 此時 FULLCHECK_DIR 請直接填 -d 輸出資料夾本身 (單一路徑)。
# FULLCHECK_MODE="native"
# FULLCHECK_NATIVE_LOG="/path/to/fullcheck.log"  # (建議) 啟動時導出的 log 檔
#     (nohup ./nimo-full-check ... > fullcheck.log 2>&1)，用於區分跑完/中途掛掉；
#     不設則程序消失一律視為跑完

# ---- 看門狗 (監控引擎自我監控) ----
# nimoshake-watchdog.sh 由 cron 每 5 分鐘獨立執行 (見 crontab.example)，
# 檢查引擎心跳 (state/.heartbeat)，停更即寄「🔴 監控引擎停擺」、恢復寄 🟢。
# WATCHDOG_STALE_SECONDS=300      # 心跳落後幾秒視為停擺 (預設 5 分鐘)
# WATCHDOG_REALERT_SECONDS=21600  # 停擺未恢復多久提醒一次 (預設 6 小時)

# ---- 系統資源判讀門檻 (附在告警信的「系統狀態判讀」表) ----
DISK_ALERT_PCT=85         # 磁碟使用率超過此 % 判為異常
MEM_ALERT_PCT=90          # 記憶體使用率超過此 % 判為異常

# STATE_DIR 預設為本 conf 所在目錄下的 state/，一般不需設定
# STATE_DIR="/opt/starco/monitor/MyShip/state"
